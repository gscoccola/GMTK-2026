  m_Script: {fileID: 11500000, guid: 953f267c8658fa14abf1746824cdb755, type: 3}
  m_Name: Alien
  m_EditorClassIdentifier: Assembly-CSharp::NPCInfoSO
  TaskDialogs:
  - ID: 15
    Briefing:
    - Hello human contraption. Help us move this. It is not important.
    Pending:
    - We have been assigned quarters on deck three. We assigned them.
    Succeded:
    - You have been very helpful. We will tell your captain.
    Failed:
    - You did not help. The piece has been moved regardless.
  - ID: 16
    Briefing:
    - Hello human creation. Hold this door while we carry something out.
    Pending:
    - We have been learning the names. The one with the arms takes things that are
      not hers. We respect this.
    Succeded:
    - The thing is out. You have done nothing wrong.
    Failed:
    - The door was not held. Why?
  - ID: 17
    Briefing:
    - One signature, see? Sign it now.
    Pending:
    - We were told there is a ceremony for new crew. Is this correct, robot?
    Succeded:
    - Signed. The reactor was ours to take. It is on the form.
    Failed:
    - There was no signature. The reactor has left with us anyway.
